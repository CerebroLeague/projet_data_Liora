# Environnement de DÉVELOPPEMENT — fichier versionné.
#
# ⚠️ NE JAMAIS écrire de clé réelle ici : ce fichier est public.
#    Les secrets vont dans `.env`, qui est exclu du dépôt.
#
# Utilisation :
#   cp .env.dev .env      puis renseigner les clés dans `.env`

# ── Sprint A : collecte ──
# Clé YouTube Data API v3 — https://console.cloud.google.com/
# Sans clé, la collecte ne tourne pas ; les données déjà collectées suffisent
# pour rejouer les étapes suivantes.
YOUTUBE_API_KEY=

# ── Sprint D : génération RAG (LLM via API) ──
# Fournisseur : mistral | openai | anthropic
LLM_PROVIDER=mistral
# Sans clé, la génération bascule automatiquement en mode mock ;
# le scoring, lui, reste réel.
LLM_API_KEY=
# Modèle (laisser vide = défaut du fournisseur)
#   mistral   -> mistral-large-latest
#   openai    -> gpt-4o-mini
#   anthropic -> claude-sonnet-4-6
LLM_MODEL=

# ── Déploiement local (ports hôte Docker) ──
API_PORT=8000
STREAMLIT_PORT=8501
