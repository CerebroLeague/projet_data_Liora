# Copier ce fichier en `.env` et renseigner les valeurs.

# ── Sprint A : collecte ──
# Clé YouTube Data API v3 — https://console.cloud.google.com/ (activer "YouTube Data API v3")
YOUTUBE_API_KEY=

# ── Sprint D : génération RAG (LLM via API) ──
# Fournisseur : mistral | openai | anthropic
LLM_PROVIDER=mistral
LLM_API_KEY=
# Modèle (laisser vide = défaut du fournisseur)
#   mistral   -> mistral-large-latest
#   openai    -> gpt-4o-mini
#   anthropic -> claude-sonnet-4-6
LLM_MODEL=

# ── Déploiement (ports hôte Docker) ──
# Défauts libres sur le VPS. Ports déjà pris : 3000, 3001, 3003, 3005, 5432.
API_PORT=8000
STREAMLIT_PORT=8501
