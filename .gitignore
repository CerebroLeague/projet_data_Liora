# Secrets
# Tout fichier d'environnement est exclu par défaut...
.env
.env.*
# ...sauf les gabarits sans clé, qui doivent rester versionnés.
!.env.example
!.env.dev

# Python
__pycache__/
*.pyc
.venv/
venv/

# Données (versionnées via DVC plus tard, pas en clair dans git)
data/raw/**/*.csv
data/raw/**/*.jsonl
data/raw/**/*.parquet
data/processed/**
models/**

# Garder les dossiers
!**/.gitkeep
